    },
    "settings.faq_7_a": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض الشاشة الرئيسية خلاصة يومية لأخبار الصحة والتغذية المصممة خصيصاً لك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Home tab features a daily feed of health and nutrition news tailored for you."
          }
        }
      }
    },
    "settings.faq_7_q": {
      "localizations": {
