    "settings.faq_1_a": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجه الكاميرا بثبات نحو البار كود حتى يتعرف عليه الماسح الضوئي تلقائياً."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your camera steady over the barcode until the scanner detects it automatically."
          }
        }
      }
    },
    "settings.faq_1_q": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف يمكنني مسح منتج؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I scan a product?"
          }
        }
      }
    },
    "settings.faq_2_a": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى تبويب المسح واختر 'الفاتورة'، ثم التقط صورة واضحة للفاتورة في إضاءة جيدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to the scan tab and select 'Receipt'. Take a clear picture of your receipt in good lighting."
          }
        }
      }
    },
    "settings.faq_2_q": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف يمكنني قراءة الفاتورة؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I read a receipt?"
          }
        }
      }
    },
    "settings.faq_3_a": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "NutriGPT هو مساعدك الذكي الشخصي الذي يساعدك في تحليل تناولك الغذائي والإجابة عن الأسئلة المتعلقة بالصحة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NutriGPT is your personal AI assistant that helps analyze your nutritional intake and answers health-related questions."
          }
        }
      }
    },
    "settings.faq_3_q": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما هو NutriGPT؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is NutriGPT?"
          }
        }
      }
    },
    "settings.faq_4_a": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى قسم السجل اليومي واضغط على زر '+' لإضافة العناصر يدوياً أو عبر المسح."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigate to the daily log section and tap the '+' button to add items manually or via scanning."
          }
        }
      }
    },
    "settings.faq_4_q": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف أسجل وجباتي اليومية؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I log my meals?"
          }
        }
      }
    },
    "settings.faq_5_a": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى إعدادات الملف الشخصي، ثم مرر إلى أفراد العائلة واضغط على 'إضافة فرد'."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Profile Settings, scroll to Family Members, and tap 'Add Member'."
          }
        }
      }
    },
    "settings.faq_5_q": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف أضيف فرد من العائلة؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do I add a family member?"
          }
        }
      }
    },
    "settings.faq_6_a": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد سجل المسح الخاص بك في لوحة تحكم الملف الشخصي تحت 'سجل المسح'."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your scan history is located on your Profile dashboard under 'Scan History'."
          }
        }
      }
    },
    "settings.faq_6_q": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين أجد سجل المسح الخاص بي؟"
