    "settings.faq_8_a": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل إلى إعدادات الملف الشخصي واضغط على أيقونة التعديل بجوار صورتك لتغيير بياناتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Profile Settings and tap the edit icon next to your avatar to change your personal details."
          }
        }
      }
    },
    "settings.faq_8_q": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كيف أعدل ملفي الشخصي؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to edit my profile?"
          }
        }
      }
    },
    "settings.faq_9_a": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نستخدم التشفير التام بين الطرفين ولا نبيع بياناتك الصحية الشخصية لأي أطراف ثالثة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use end-to-end encryption and never sell your personal health data to third parties."
          }
        }
      }
    },
    "settings.faq_9_q": {
      "localizations": {
