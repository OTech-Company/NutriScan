    "settings.terms": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشروط والأحكام"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terms and Conditions"
          }
        }
      }
    },
    "settings.terms_1_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بإنشاء حساب واستخدام NutriScan، فإنك توافق على هذه الشروط والأحكام. إذا كنت لا توافق، يرجى عدم استخدام التطبيق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By creating an account and using NutriScan, you agree to these Terms and Conditions. If you don't agree, please don't use the app."
          }
        }
      }
    },
    "settings.terms_1_title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موافقة الشروط والأحكام"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptance of Terms"
          }
        }
      }
    },
    "settings.terms_2_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم توفير NutriScan لتتبع التغذية الشخصية. توافق على استخدامه للأغراض المشروعة فقط والحفاظ على سرية بيانات حسابك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NutriScan is provided for personal nutrition tracking. You agree to use it only for lawful purposes and to keep your account credentials secure."
          }
        }
      }
    },
    "settings.terms_2_title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام التطبيق"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use of the App"
          }
        }
      }
    },
    "settings.terms_3_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعلومات الغذائية وتقديرات السعرات وإجابات NutriGPT هي لأغراض تثقيفية فقط وليست بديلاً عن الاستشارة الطبية أو الغذائية المتخصصة. استشر طبيباً متأهلاً لاتخاذ القرارات الطبية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutrition information, calorie estimates, and NutriGPT responses are for informational purposes only and are not a substitute for professional medical or dietary advice. Consult a qualified professional for medical decisions."
          }
        }
      }
    },
    "settings.terms_3_title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخلاء مسؤولية طبية"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Medical Advice"
          }
        }
      }
    },
    "settings.terms_4_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم معالجة الصور الملتقطة لمسح البار كود أو الفواتير لاستخراج البيانات الغذائية، ولا يتم مشاركتها مع أطراف ثالثة خارج النطاق المطلوب لتقديم هذه الميزة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos taken for barcode or receipt scanning are processed to extract nutrition data and are not shared with third parties beyond what's required to provide this feature."
          }
        }
      }
    },
    "settings.terms_4_title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات الكاميرا والمسح"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning and Camera Data"
          }
        }
      }
    },
    "settings.terms_5_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم توليد ردود NutriGPT تلقائياً وقد تحتوي أحياناً على عدم دقة. يرجى استخدام تقديرك الخاص قبل الاعتماد على اقتراحات الذكاء الاصطناعي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Responses from NutriGPT are generated automatically and may occasionally be inaccurate. Use your judgment before acting on AI-provided suggestions."
          }
        }
      }
    },
    "settings.terms_5_title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المساعد الذكي (NutriGPT)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Assistant (NutriGPT)"
          }
        }
      }
    },
    "settings.terms_6_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت مسؤول عن دقة المعلومات المدخلة لنفسك ولأي ملفات شخصية لأفراد عائلتك تديرها تحت حسابك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're responsible for the accuracy of information entered for yourself and any family profiles you manage under your account."
          }
        }
      }
    },
    "settings.terms_6_title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب العائلة والملفات الشخصية"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account and Family Profiles"
          }
        }
      }
    },
    "settings.terms_7_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد نقوم بتحديث هذه الشروط من وقت لآخر. إن استمرار استخدامك للتطبيق بعد إجراء التغييرات يعني موافقتك على الشروط المحدثة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We may update these Terms from time to time. Continued use of the app after changes means you accept the updated Terms."
          }
